#!/usr/bin/env bash
# MozVPS terminal control. Credentials are entered by the Python helper and are never echoed.
set -u

SERVICE='mozvps.service'
INSTALLER='/opt/mozvps/install.sh'
APP='/opt/mozvps'
DATA='/var/lib/mozvps'
LAUNCHER='/usr/local/bin/mozvps'

if [[ -t 1 && -z ${NO_COLOR:-} && ${TERM:-} != dumb ]]; then
    cyan=$'\033[1;36m'; green=$'\033[1;32m'; yellow=$'\033[1;33m'; red=$'\033[1;31m'; reset=$'\033[0m'
else
    cyan=; green=; yellow=; red=; reset=
fi

privileged() {
    if (( EUID == 0 )); then
        "$@"
    elif command -v sudo >/dev/null 2>&1; then
        sudo -- "$@"
    else
        printf '%s\n' 'Error: sudo is required for this operation.' >&2
        return 1
    fi
}

python_app() {
    if [[ -x "$APP/venv/bin/python" && -f "$APP/server.py" ]]; then
        privileged env MOZVPS_DATA="$DATA" HOME="$DATA" "$APP/venv/bin/python" "$APP/server.py" "$@"
    else
        printf 'Error: MozVPS installation was not found at %s\n' "$APP" >&2
        return 1
    fi
}

panel_info() {
    local addr found=0
    printf '\n%sMozVPS panel information%s\n' "$cyan" "$reset"
    printf '  Default listener: 0.0.0.0:1234\n'
    printf '  Local URL:        http://127.0.0.1:1234/\n'
    if command -v hostname >/dev/null 2>&1; then
        for addr in $(hostname -I 2>/dev/null || true); do
            case "$addr" in
                *:*) printf '  Network URL:      http://[%s]:1234/\n' "$addr" ;;
                *)   printf '  Network URL:      http://%s:1234/\n' "$addr" ;;
            esac
            found=1
        done
    fi
    (( found )) || printf '  Public URL:       http://<SERVER-IP>:1234/\n'
    printf '  Change the port or enable TLS from the web panel configuration.\n'
    printf '  The initial panel password is admin; change it immediately.\n\n'
}

uninstall_all() {
    printf '\n%sWARNING: this permanently deletes the MozVPS installation and all stored data.%s\n' "$red" "$reset"
    printf 'This includes Mozilla accounts, passwords, tokens, TOTP secrets, panel settings, logs, and code.\n'
    printf 'Type exactly %s to continue: ' 'DELETE MOZVPS'
    local confirmation
    IFS= read -r confirmation || return 1
    [[ "$confirmation" == 'DELETE MOZVPS' ]] || { printf 'Cancelled.\n'; return 1; }

    printf 'Stopping and disabling service...\n'
    privileged systemctl stop "$SERVICE" >/dev/null 2>&1 || true
    privileged systemctl disable "$SERVICE" >/dev/null 2>&1 || true
    privileged rm -f "/etc/systemd/system/$SERVICE"
    privileged rm -rf "/etc/systemd/system/$SERVICE.d"
    privileged systemctl daemon-reload >/dev/null 2>&1 || true

    printf 'Removing application and persistent data...\n'
    privileged rm -rf "$APP" "$DATA" "/root/.mozvps" "/root/.mozvps-data" "/root/mozvpn"

    if getent passwd mozvps >/dev/null 2>&1; then privileged userdel mozvps >/dev/null 2>&1 || true; fi
    if getent group mozvps >/dev/null 2>&1; then privileged groupdel mozvps >/dev/null 2>&1 || true; fi
    printf '%sMozVPS has been completely removed.%s\n' "$green" "$reset"
    printf 'The launcher will now be removed.\n'
    privileged rm -f "$LAUNCHER"
    return 0
}

show_help() {
    cat <<'EOF'
Usage: mozvps [start|stop|restart|status|add-account|list-accounts|update|logs|info|uninstall]
Without an argument, the interactive menu is shown.
  start          Start the panel and proxy worker
  stop           Stop the panel and proxy worker
  restart        Restart the service
  status         Show systemd status
  add-account    Add and authenticate a Firefox/Mozilla account
  list-accounts  List configured accounts without secrets
  update         Safely update from the configured GitHub repository
  logs           Follow service logs (Ctrl+C to exit)
  info           Show panel addresses and security notes
  uninstall      Permanently remove the application and all stored data
EOF
}

run_command() {
    case "${1:-}" in
        start|stop|restart) privileged systemctl "$1" "$SERVICE" ;;
        status) privileged systemctl status --no-pager --full "$SERVICE" ;;
        add-account) python_app --add-account ;;
        list-accounts) python_app --list-accounts ;;
        logs) privileged journalctl -u "$SERVICE" -n 100 -f --no-pager ;;
        update)
            [[ -f "$INSTALLER" && ! -L "$INSTALLER" ]] || { printf 'Error: installer not found: %s\n' "$INSTALLER" >&2; return 1; }
            privileged /bin/bash "$INSTALLER" --update
            ;;
        info) panel_info ;;
        uninstall) uninstall_all ;;
        *) printf 'Unknown command: %s\n' "${1:-}" >&2; show_help >&2; return 2 ;;
    esac
}

if (( $# > 0 )); then
    if (( $# != 1 )); then show_help >&2; exit 2; fi
    case "$1" in -h|--help|help) show_help; exit 0 ;; esac
    run_command "$1"
    exit $?
fi

while :; do
    printf '\n%s╔══════════════════════════════════════════════╗%s\n' "$cyan" "$reset"
    printf '%s║              MozVPS Control Menu             ║%s\n' "$cyan" "$reset"
    printf '%s╚══════════════════════════════════════════════╝%s\n' "$cyan" "$reset"
    printf '%s  1%s  Start service\n' "$green" "$reset"
    printf '%s  2%s  Stop service\n' "$green" "$reset"
    printf '%s  3%s  Restart service\n' "$green" "$reset"
    printf '%s  4%s  Show status\n' "$green" "$reset"
    printf '%s  5%s  Add Firefox/Mozilla account\n' "$green" "$reset"
    printf '%s  6%s  List configured accounts\n' "$green" "$reset"
    printf '%s  7%s  Update from GitHub\n' "$green" "$reset"
    printf '%s  8%s  View service logs\n' "$green" "$reset"
    printf '%s  9%s  Panel information\n' "$green" "$reset"
    printf '%s  U%s  Uninstall MozVPS and delete all data\n' "$red" "$reset"
    printf '%s  0%s  Exit\n' "$yellow" "$reset"
    printf 'Select an option: '
    if ! IFS= read -r choice; then printf '\n'; break; fi
    case "$choice" in
        1) run_command start || true ;;
        2) run_command stop || true ;;
        3) run_command restart || true ;;
        4) run_command status || true ;;
        5) run_command add-account || true ;;
        6) run_command list-accounts || true ;;
        7) run_command update || true ;;
        8) run_command logs || true ;;
        9) run_command info || true ;;
        [uU]) run_command uninstall || true; break ;;
        0) break ;;
        *) printf 'Invalid option.\n' >&2 ;;
    esac
done
